{
  "name": "001-game-vault",
  "version": "1.0.0",
  "description": "GameVault is a Node.js, TypeScript, and MongoDB command-line application for managing a personal video game collection.",
  "main": "app.js",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "typecheck": "tsc --noEmit",
    "db:clear": "tsx ./src/infrastructure/database/mongodb/scripts/clear-database.script.ts",
    "db:seed": "tsx ./src/infrastructure/database/mongodb/scripts/seed.script.ts",
    "format": "tsc --noEmit && prettier --write .",
    "format:check": "tsc --noEmit && prettier --check ."
  },
  "keywords": [],
  "author": "jsalguero.dev",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.1.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "env-var": "^7.5.0",
    "mongoose": "^9.8.0",
    "slugify": "^1.6.9"
  },
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c"
}
