{
  "name": "001-game-vault",
  "version": "1.0.0",
  "description": "GameVault is a Node.js, TypeScript, and MongoDB command-line application for managing a personal video game collection.",
  "main": "app.js",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "typecheck": "tsc --noEmit",
    "db:clear": "tsx ./src/infrastructure/database/mongodb/scripts/clear-database.script.ts",
    "db:seed": "tsx ./src/infrastructure/database/mongodb/scripts/seed.script.ts",
    "format": "tsc --noEmit && prettier --write .",
    "format:check": "tsc --noEmit && prettier --check ."
  },
  "keywords": [],
  "author": "jsalguero.dev",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.1.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "env-var": "^7.5.0",
    "mongoose": "^9.8.0",
    "slugify": "^1.6.9"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
}
