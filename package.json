{
  "name": "001-game-vault",
  "version": "1.0.0",
  "description": "GameVault is a Node.js, TypeScript, and MongoDB command-line application for managing a personal video game collection.",
  "main": "app.js",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "typecheck": "tsc --noEmit",
    "db:clear": "tsx ./src/infrastructure/database/mongodb/scripts/clear-database.script.ts",
    "db:seed": "tsx ./src/infrastructure/database/mongodb/scripts/seed.script.ts",
    "format": "tsc --noEmit && prettier --write .",
    "format:check": "tsc --noEmit && prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "jsalguero.dev",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.1.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "env-var": "^7.5.0",
    "mongoose": "^9.8.0",
    "slugify": "^1.6.9"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
