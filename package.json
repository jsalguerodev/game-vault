{
  "name": "001-game-vault",
  "version": "1.0.0",
  "description": "GameVault is a Node.js, TypeScript, and MongoDB command-line application for managing a personal video game collection.",
  "main": "app.js",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "typecheck": "tsc --noEmit",
    "db:clear": "tsx ./src/infrastructure/database/mongodb/scripts/clear-database.script.ts",
    "db:seed": "tsx ./src/infrastructure/database/mongodb/scripts/seed.script.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "jsalguero.dev",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.1.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "env-var": "^7.5.0",
    "mongoose": "^9.8.0"
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72"
}
